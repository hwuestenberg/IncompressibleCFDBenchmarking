#!/usr/bin/env bash
#
# Template for the machine-specific solver executable paths used by
# run_case.sh / run_all.sh. Copy this file to env.sh (in this same
# directory) and edit the paths for your build layout, then run:
#
#   source env.sh
#   ./run_all.sh ...
#
# env.sh itself is intentionally not committed/shared -- every machine
# (workstation, HX1, ...) and every build tree (legacy, redesign AVX,
# redesign CUDA/HIP/SYCL) has different paths, and no path should be
# hardcoded into the case files or scripts.
#
# Only set the variables you actually need for the runs you're doing --
# run_case.sh only checks the one variable relevant to the run requested.

# Legacy reference solver (any plain CPU build of Nektar++).
export NEKTAR_LEGACY_BIN="/path/to/legacy/build/dist/bin/IncNavierStokesSolver"

# Redesign binary for Serial or AVX. Set the Device override for a separate GPU build.
export NEKTAR_REDESIGN_BIN="/path/to/redesign-avx-build/dist/bin/IncNavierStokesSolverRedesign"
export NEKTAR_REDESIGN_DEVICE_BIN="/path/to/redesign-cuda-build/dist/bin/IncNavierStokesSolverRedesign"

# NekMesh and gmsh, for ../build_mesh.sh (any build with
# NEKTAR_BUILD_UTILITIES=ON).
export NEKMESH_BIN="/path/to/legacy/build/dist/bin/NekMesh"
export GMSH_BIN="/path/to/gmsh"

# MPI launcher and rank count, used by run_case.sh/run_all.sh for
# parallel runs (set MPI_NP=1 to run serially without mpirun; this case
# is expensive -- expect to need MPI_NP > 1 for anything beyond a short
# smoke test).
export MPI_LAUNCHER="${MPI_LAUNCHER:-mpirun}"
export MPI_NP="${MPI_NP:-1}"
