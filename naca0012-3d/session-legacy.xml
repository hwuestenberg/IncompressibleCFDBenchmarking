        <FILTER TYPE="ReynoldsStresses">
            <PARAM NAME="OutputFile">stats</PARAM>
            <PARAM NAME="OutputFrequency">StatOutputSteps</PARAM>
            <PARAM NAME="SampleFrequency">StatSampleSteps</PARAM>
            <PARAM NAME="OutputStartTime">StatStartTime</PARAM>
        </FILTER>
        <FILTER TYPE="Checkpoint">
            <PARAM NAME="OutputFile">chk</PARAM>
            <PARAM NAME="OutputFrequency">10</PARAM>
        </FILTER>
    </FILTERS>
</NEKTAR>
