<?xml version="1.0" encoding="utf-8"?>
<NEKTAR>
    <EXPANSIONS>
        <E COMPOSITE="C[0,2]" NUMMODES="3" TYPE="MODIFIED" FIELDS="u,v,w,p"/>
    </EXPANSIONS>
    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="Projection" VALUE="Galerkin"/>
            <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes"/>
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme"/>
            <I PROPERTY="SPECTRALHPDEALIASING" VALUE="True"/>
        </SOLVERINFO>
        <GLOBALSYSSOLNINFO>
            <V VAR="u,v,w">
                <I PROPERTY="GlobalSysSoln" VALUE="IterativeStaticCond"/>
                <I PROPERTY="Preconditioner" VALUE="Diagonal"/>
                <I PROPERTY="IterativeSolverTolerance" VALUE="1e-2"/>
                <I PROPERTY="AbsoluteTolerance" VALUE="True"/>
                <I PROPERTY="NekLinSysMaxIterations" VALUE="5000"/>
            </V>
            <V VAR="p">
                <I PROPERTY="GlobalSysSoln" VALUE="IterativeStaticCond"/>
                <I PROPERTY="Preconditioner" VALUE="Diagonal"/>
                <I PROPERTY="IterativeSolverTolerance" VALUE="1e-4"/>
                <I PROPERTY="AbsoluteTolerance" VALUE="True"/>
                <I PROPERTY="NekLinSysMaxIterations" VALUE="5000"/>
            </V>
        </GLOBALSYSSOLNINFO>
        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 2 </ORDER>
        </TIMEINTEGRATIONSCHEME>
        <PARAMETERS>
            <P> TimeStep    = 1.0e-4 </P>
            <P> LenWing     = 1.0                      </P>
            <P> UInf        = 1.0                      </P>
            <P> alpha       = 5.0*PI/180               </P>
            <P> uInf        = UInf*cos(alpha)          </P>
            <P> vInf        = UInf*sin(alpha)          </P>
            <P> Re          = 5e4                      </P>
            <P> Kinvis      = UInf*LenWing/Re          </P>
            <P> CTU         = 1.0                      </P>
            <P> StepsPerCTU = floor(LenWing/TimeStep + 0.5) </P>
            <P> T           = 100*CTU                  </P>
            <P> NumSteps    = floor(T/TimeStep + 0.5)  </P>
            <P> IO_InfoSteps = 1                       </P>
            <P> IO_CFLSteps  = 1                       </P>
            <P> FceSteps        = 1                    </P>
            <P> HisSteps        = 1                    </P>
            <P> EnergySteps     = StepsPerCTU/250      </P>
            <P> StatSampleSteps = StepsPerCTU/250      </P>
            <P> StatOutputSteps = StepsPerCTU          </P>
            <P> StatStartTime   = 0.0                  </P>
            <P> ChkSteps        = StepsPerCTU/5        </P>
        </PARAMETERS>
        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> w </V>
            <V ID="3"> p </V>
        </VARIABLES>
        <BOUNDARYREGIONS>
            <B ID="0" NAME="Wing">      C[6]  </B>
            <B ID="1" NAME="Outflow">   C[8]  </B>
            <B ID="2" NAME="Periodic1"> C[4]  </B>
            <B ID="3" NAME="Periodic2"> C[5]  </B>
            <B ID="4" NAME="Farfield">  C[7]  </B>
            <B ID="5" NAME="Nose">      C[9]  </B>
            <B ID="6" NAME="TrailEdge"> C[10] </B>
        </BOUNDARYREGIONS>
        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="0"/>
                <D VAR="v" VALUE="0"/>
                <D VAR="w" VALUE="0"/>
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
            <REGION REF="1">
                <N VAR="u" USERDEFINEDTYPE="HOutflow" VALUE="0"/>
                <N VAR="v" USERDEFINEDTYPE="HOutflow" VALUE="0"/>
                <N VAR="w" USERDEFINEDTYPE="HOutflow" VALUE="0"/>
                <D VAR="p" USERDEFINEDTYPE="HOutflow" VALUE="0"/>
            </REGION>
            <REGION REF="2">
                <P VAR="u" VALUE="[3]"/>
                <P VAR="v" VALUE="[3]"/>
                <P VAR="w" VALUE="[3]"/>
                <P VAR="p" VALUE="[3]"/>
            </REGION>
            <REGION REF="3">
                <P VAR="u" VALUE="[2]"/>
                <P VAR="v" VALUE="[2]"/>
                <P VAR="w" VALUE="[2]"/>
                <P VAR="p" VALUE="[2]"/>
            </REGION>
            <REGION REF="4">
                <D VAR="u" VALUE="uInf"/>
                <D VAR="v" VALUE="vInf"/>
                <D VAR="w" VALUE="0"/>
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
            <REGION REF="5">
                <D VAR="u" VALUE="0"/>
                <D VAR="v" VALUE="0"/>
                <D VAR="w" VALUE="0"/>
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
            <REGION REF="6">
                <D VAR="u" VALUE="0"/>
                <D VAR="v" VALUE="0"/>
                <D VAR="w" VALUE="0"/>
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
        </BOUNDARYCONDITIONS>
        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="uInf"/>
            <E VAR="v" VALUE="vInf"/>
            <E VAR="w" VALUE="0"/>
            <E VAR="p" VALUE="0"/>
        </FUNCTION>
    </CONDITIONS>
    <FILTERS>
        <FILTER TYPE="AeroForces">
            <PARAM NAME="OutputFile">forces-all</PARAM>
            <PARAM NAME="OutputFrequency">FceSteps</PARAM>
            <PARAM NAME="Boundary">B[0,5,6]</PARAM>
            <PARAM NAME="Direction1">cos(alpha) sin(alpha) 0</PARAM>
            <PARAM NAME="Direction2">-sin(alpha) cos(alpha) 0</PARAM>
            <PARAM NAME="Direction3">0 0 1</PARAM>
            <PARAM NAME="PivotPoint">0.25 0 0</PARAM>
        </FILTER>
        <FILTER TYPE="AeroForces">
            <PARAM NAME="OutputFile">forces-wing</PARAM>
            <PARAM NAME="OutputFrequency">FceSteps</PARAM>
            <PARAM NAME="Boundary">B[0]</PARAM>
            <PARAM NAME="Direction1">cos(alpha) sin(alpha) 0</PARAM>
            <PARAM NAME="Direction2">-sin(alpha) cos(alpha) 0</PARAM>
            <PARAM NAME="Direction3">0 0 1</PARAM>
            <PARAM NAME="PivotPoint">0.25 0 0</PARAM>
        </FILTER>
        <FILTER TYPE="AeroForces">
            <PARAM NAME="OutputFile">forces-nose</PARAM>
            <PARAM NAME="OutputFrequency">FceSteps</PARAM>
            <PARAM NAME="Boundary">B[5]</PARAM>
            <PARAM NAME="Direction1">cos(alpha) sin(alpha) 0</PARAM>
            <PARAM NAME="Direction2">-sin(alpha) cos(alpha) 0</PARAM>
            <PARAM NAME="Direction3">0 0 1</PARAM>
            <PARAM NAME="PivotPoint">0.25 0 0</PARAM>
        </FILTER>
        <FILTER TYPE="AeroForces">
            <PARAM NAME="OutputFile">forces-te</PARAM>
            <PARAM NAME="OutputFrequency">FceSteps</PARAM>
            <PARAM NAME="Boundary">B[6]</PARAM>
            <PARAM NAME="Direction1">cos(alpha) sin(alpha) 0</PARAM>
            <PARAM NAME="Direction2">-sin(alpha) cos(alpha) 0</PARAM>
            <PARAM NAME="Direction3">0 0 1</PARAM>
            <PARAM NAME="PivotPoint">0.25 0 0</PARAM>
        </FILTER>
        <FILTER TYPE="Energy">
            <PARAM NAME="OutputFile">energy</PARAM>
            <PARAM NAME="OutputFrequency">EnergySteps</PARAM>
        </FILTER>
        <FILTER TYPE="Mean">
            <PARAM NAME="OutputFile">mean</PARAM>
            <PARAM NAME="OutputFrequency">EnergySteps</PARAM>
        </FILTER>
        <FILTER TYPE="HistoryPoints">
            <PARAM NAME="OutputFile">history</PARAM>
            <PARAM NAME="OutputFrequency">HisSteps</PARAM>
            <PARAM NAME="Points">
                0.04942065 0.03746418 0.10000000
