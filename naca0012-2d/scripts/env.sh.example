#!/usr/bin/env bash
#
# Template for the machine-specific solver executable paths used by
# run_case.sh / run_all.sh. Copy this file to env.sh (in this same
# directory), edit the paths for your build layout, then:
#
#   source env.sh
#   ./run_all.sh
#
# env.sh itself is intentionally not committed/shared -- every machine and
# every build tree has different paths, and no path is hardcoded into the
# case files or scripts. Only set the variables you need.

# Legacy reference solver (any plain CPU build of Nektar++).
export NEKTAR_LEGACY_BIN="/path/to/legacy/build/dist/bin/IncNavierStokesSolver"

# Redesign binary for Serial or AVX. Set the Device override for a separate GPU build.
export NEKTAR_REDESIGN_BIN="/path/to/redesign-build/dist/bin/IncNavierStokesSolverRedesign"
export NEKTAR_REDESIGN_DEVICE_BIN="/path/to/redesign-hip-build/dist/bin/IncNavierStokesSolverRedesign"

# Optional if AVX requires a different build.
# export NEKTAR_REDESIGN_AVX_BIN="/path/to/redesign-avx-build/dist/bin/IncNavierStokesSolverRedesign"

# MPI launcher and per-exec-space rank counts (1 = run without mpirun).
# Serial/AVX/legacy scale with CPU ranks; Device runs one rank per GPU.
export MPI_LAUNCHER="${MPI_LAUNCHER:-mpirun}"
export MPI_NP="${MPI_NP:-1}"
export MPI_NP_DEVICE="${MPI_NP_DEVICE:-1}"

# export HIP_VISIBLE_DEVICES=0 ROCR_VISIBLE_DEVICES=0
