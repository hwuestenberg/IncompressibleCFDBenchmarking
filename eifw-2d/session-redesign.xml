<?xml version='1.0' encoding='utf-8'?>
<NEKTAR>
    <EXPANSIONS>
        <E COMPOSITE="C[0]" BASISTYPE="Modified_A,Modified_B" NUMMODES="6,6" POINTSTYPE="GaussLobattoLegendre,GaussRadauMAlpha1Beta0" NUMPOINTS="9,8" FIELDS="u,v" />
        <E COMPOSITE="C[0]" BASISTYPE="Modified_A,Modified_B" NUMMODES="6,6" POINTSTYPE="GaussLobattoLegendre,GaussRadauMAlpha1Beta0" NUMPOINTS="9,8" FIELDS="p" />
        <E COMPOSITE="C[1]" BASISTYPE="Modified_A,Modified_A" NUMMODES="6,6" POINTSTYPE="GaussLobattoLegendre,GaussLobattoLegendre" NUMPOINTS="9,9" FIELDS="u,v" />
        <E COMPOSITE="C[1]" BASISTYPE="Modified_A,Modified_A" NUMMODES="6,6" POINTSTYPE="GaussLobattoLegendre,GaussLobattoLegendre" NUMPOINTS="9,9" FIELDS="p" />
    </EXPANSIONS>
    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme" />
            <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes" />
            <I PROPERTY="Projection" VALUE="Galerkin" />
            <I PROPERTY="AdvectionForm" VALUE="Convective" />
            <I PROPERTY="SPECTRALHPDEALIASING" VALUE="True" />
            <I PROPERTY="FORMULATION" VALUE="semiimplicit" />
        </SOLVERINFO>
        <GLOBALSYSSOLNINFO>
            <V VAR="u,v">
                <I PROPERTY="Preconditioner" VALUE="Diagonal" />
                <I PROPERTY="IterativeSolverTolerance" VALUE="1e-4" />
                <I PROPERTY="AbsoluteTolerance" VALUE="True" />
                <I PROPERTY="NekLinSysMaxIterations" VALUE="5000" />
            </V>
            <V VAR="p">
                <I PROPERTY="Preconditioner" VALUE="Diagonal" />
                <I PROPERTY="IterativeSolverTolerance" VALUE="1e-6" />
                <I PROPERTY="AbsoluteTolerance" VALUE="True" />
                <I PROPERTY="NekLinSysMaxIterations" VALUE="5000" />
            </V>
        </GLOBALSYSSOLNINFO>
        <TIMEINTEGRATIONSCHEME>
            <METHOD>IMEX</METHOD>
            <ORDER>2</ORDER>
        </TIMEINTEGRATIONSCHEME>
        <PARAMETERS>
            <P>TimeStep = 1e-7</P>
            <P>NumSteps = 50000</P>
            <P>IO_InfoSteps = 1000</P>
            <P>IO_CFLSteps = 100</P>
            <P>Re = 2.2e5</P>
            <P>Linf = 0.25</P>
            <P>Kinvis = Linf/Re</P>
        </PARAMETERS>
        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> p </V>
        </VARIABLES>
        <BOUNDARYREGIONS>
            <B ID="0"> C[7,10]	       </B>
            <B ID="1"> C[6,9]	       </B>
            <B ID="2"> C[8,11]	       </B>
            <B ID="3"> C[2]        </B>
            <B ID="4"> C[5]        </B>
            <B ID="5"> C[3]        </B>
            <B ID="6"> C[4]        </B>
        </BOUNDARYREGIONS>
        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
            <REGION REF="1">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
            <REGION REF="2">
                <D VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
            <REGION REF="3">
                <D VAR="u" VALUE="1" />
                <D VAR="v" VALUE="0" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
            <REGION REF="4">
                <D VAR="u" VALUE="1" />
                <D VAR="v" VALUE="0" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
            <REGION REF="5">
                <N VAR="u" USERDEFINEDTYPE="HOutflow" VALUE="0" />
                <N VAR="v" USERDEFINEDTYPE="HOutflow" VALUE="0" />
                <D VAR="p" USERDEFINEDTYPE="HOutflow" VALUE="0" />
            </REGION>
            <REGION REF="6">
                <N VAR="u" VALUE="0" />
                <D VAR="v" VALUE="0" />
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0" />
            </REGION>
        </BOUNDARYCONDITIONS>
        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="1" />
            <E VAR="v" VALUE="0" />
            <E VAR="p" VALUE="0" />
        </FUNCTION>
    </CONDITIONS>
    <FILTERS>
        <FILTER TYPE="AeroForces">
            <PARAM NAME="OutputFile">total.fce</PARAM>
            <PARAM NAME="OutputFrequency">100</PARAM>
            <PARAM NAME="Boundary">B[0,1,2]</PARAM>
        </FILTER>
        <FILTER TYPE="AeroForces">
            <PARAM NAME="OutputFile">mainplane.fce</PARAM>
            <PARAM NAME="OutputFrequency">100</PARAM>
            <PARAM NAME="Boundary">B[0]</PARAM>
        </FILTER>
        <FILTER TYPE="AeroForces">
            <PARAM NAME="OutputFile">flap1.fce</PARAM>
            <PARAM NAME="OutputFrequency">100</PARAM>
            <PARAM NAME="Boundary">B[1]</PARAM>
        </FILTER>
        <FILTER TYPE="AeroForces">
            <PARAM NAME="OutputFile">flap2.fce</PARAM>
            <PARAM NAME="OutputFrequency">100</PARAM>
            <PARAM NAME="Boundary">B[2]</PARAM>
        </FILTER>
    </FILTERS>
</NEKTAR>