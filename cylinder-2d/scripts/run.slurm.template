#!/bin/bash
#
# Slurm job template for the 2D cylinder vortex-shedding validation
# benchmark. Copy this file (e.g. to run.slurm), adjust the #SBATCH
# resource directives for your allocation, and edit the "job
# configuration" section below. No solver paths are hardcoded here --
# they come from env.sh (copied from ../scripts/env.sh.example), matching
# every other script in this case so the same files work unmodified
# across machines/clusters.

#SBATCH --time=20:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=64
#SBATCH --mem=32G

set -euo pipefail

cd "$SLURM_SUBMIT_DIR"
SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- job configuration ---
SOLVER=legacy             # legacy | semiimplicit | linearimplicit
EXEC_SPACE=Serial         # Serial | AVX | Device (ignored for SOLVER=legacy)
export MPI_NP="${SLURM_NTASKS:-1}"
export MPI_LAUNCHER=mpirun
# --------------------------

source "$SCRIPTS_DIR/env.sh"

echo "Node list: $SLURM_JOB_NODELIST"
echo "Ranks: $MPI_NP"

if [ "$SOLVER" = "legacy" ]; then
    "$SCRIPTS_DIR/run_case.sh" --solver "$SOLVER" \
        --outdir "$SLURM_SUBMIT_DIR/results/$SOLVER"
else
    "$SCRIPTS_DIR/run_case.sh" --solver "$SOLVER" --exec-space "$EXEC_SPACE" \
        --outdir "$SLURM_SUBMIT_DIR/results/$SOLVER-$EXEC_SPACE"
fi
