<?xml version="1.0" encoding="utf-8"?>
<NEKTAR>
    <EXPANSIONS>
        <E COMPOSITE="C[1]" NUMMODES="7" TYPE="MODIFIED" FIELDS="u,v,p"/>
    </EXPANSIONS>
    <CONDITIONS>
        <SOLVERINFO>
            <I PROPERTY="Projection" VALUE="Galerkin"/>
            <I PROPERTY="EQTYPE" VALUE="UnsteadyNavierStokes"/>
            <I PROPERTY="SolverType" VALUE="VelocityCorrectionScheme"/>
        </SOLVERINFO>
        <TIMEINTEGRATIONSCHEME>
            <METHOD> IMEX </METHOD>
            <ORDER> 2 </ORDER>
        </TIMEINTEGRATIONSCHEME>
        <PARAMETERS>
            <P> TimeStep       = 0.005          </P>
            <P> FinalTime      = 1000.0         </P>
            <P> NumSteps       = FinalTime/TimeStep </P>
            <P> IO_InfoSteps   = 200             </P>
            <P> IO_CFLSteps    = 200             </P>
            <P> Re             = 100             </P>
            <P> Kinvis         = 1/Re            </P>
        </PARAMETERS>
        <GLOBALSYSSOLNINFO>
            <V VAR="u,v">
                <I PROPERTY="GlobalSysSoln" VALUE="IterativeStaticCond"/>
                <I PROPERTY="Preconditioner" VALUE="Diagonal"/>
                <I PROPERTY="IterativeSolverTolerance" VALUE="1e-8"/>
                <I PROPERTY="AbsoluteTolerance" VALUE="True"/>
            </V>
            <V VAR="p">
                <I PROPERTY="GlobalSysSoln" VALUE="IterativeStaticCond"/>
                <I PROPERTY="Preconditioner" VALUE="Diagonal"/>
                <I PROPERTY="IterativeSolverTolerance" VALUE="1e-8"/>
                <I PROPERTY="AbsoluteTolerance" VALUE="True"/>
            </V>
        </GLOBALSYSSOLNINFO>
        <VARIABLES>
            <V ID="0"> u </V>
            <V ID="1"> v </V>
            <V ID="2"> p </V>
        </VARIABLES>
        <BOUNDARYREGIONS>
            <B ID="0"> C[6] </B>
            <B ID="1"> C[4] </B>
            <B ID="2"> C[3] </B>
            <B ID="3"> C[2] </B>
            <B ID="4"> C[5] </B>
        </BOUNDARYREGIONS>
        <BOUNDARYCONDITIONS>
            <REGION REF="0">
                <D VAR="u" VALUE="0"/>
                <D VAR="v" VALUE="0"/>
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
            <REGION REF="1">
                <N VAR="u" VALUE="0"/>
                <D VAR="v" VALUE="0"/>
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
            <REGION REF="2">
                <N VAR="u" USERDEFINEDTYPE="HOutflow" VALUE="0"/>
                <N VAR="v" USERDEFINEDTYPE="HOutflow" VALUE="0"/>
                <D VAR="p" USERDEFINEDTYPE="HOutflow" VALUE="0"/>
            </REGION>
            <REGION REF="3">
                <D VAR="u" VALUE="1"/>
                <D VAR="v" VALUE="0"/>
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
            <REGION REF="4">
                <N VAR="u" VALUE="0"/>
                <D VAR="v" VALUE="0"/>
                <N VAR="p" USERDEFINEDTYPE="H" VALUE="0"/>
            </REGION>
        </BOUNDARYCONDITIONS>
        <FUNCTION NAME="InitialConditions">
            <E VAR="u" VALUE="1.0"/>
            <E VAR="v" VALUE="0.0"/>
            <E VAR="p" VALUE="0"/>
        </FUNCTION>
    </CONDITIONS>
    <FILTERS>
        <FILTER TYPE="AeroForces">
            <PARAM NAME="OutputFile">DragLift</PARAM>
            <PARAM NAME="OutputFrequency">1</PARAM>
            <PARAM NAME="Boundary"> B[0] </PARAM>
        </FILTER>
        <FILTER TYPE="Energy">
            <PARAM NAME="OutputFile">EnergyFile</PARAM>
            <PARAM NAME="OutputFrequency">50</PARAM>
        </FILTER>
        <FILTER TYPE="Checkpoint">
            <PARAM NAME="OutputFile">cylinder-2d</PARAM>
            <PARAM NAME="OutputFrequency">10</PARAM>
        </FILTER>
    </FILTERS>
</NEKTAR>
